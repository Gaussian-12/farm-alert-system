<%
  pageTitle = 'Dashboard';
  title = 'Dashboard';
  locals.body = '';
%>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FarmAlert — Dashboard</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Space+Mono:wght@400;700&family=Syne:wght@400;600;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --green: #2d6a2d; --green-light: #4a9e4a; --green-pale: #e8f5e8;
            --gold: #c8941a; --gold-light: #f0b429; --earth: #8b6914;
            --bg: #f5f0e8; --white: #fff; --text: #1a1a0e; --muted: #6b6b50;
            --border: #d4c9a8; --red: #c0392b; --shadow: 0 2px 12px rgba(45,106,45,0.10);
        }
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: 'Syne', sans-serif; background: var(--bg); color: var(--text); display: flex; min-height: 100vh; }
        .sidebar { width: 240px; background: var(--green); color: #fff; display: flex; flex-direction: column; padding: 0; min-height: 100vh; position: fixed; top: 0; left: 0; bottom: 0; z-index: 100; }
        .sidebar-brand { padding: 28px 20px 20px; border-bottom: 1px solid rgba(255,255,255,0.15); }
        .sidebar-brand .logo-text { font-size: 1.35rem; font-weight: 800; letter-spacing: -0.5px; line-height: 1.1; color: #fff; }
        .sidebar-brand .logo-sub { font-family: 'Space Mono', monospace; font-size: 0.65rem; color: rgba(255,255,255,0.6); letter-spacing: 2px; text-transform: uppercase; margin-top: 2px; }
        .sidebar nav { padding: 16px 0; flex: 1; }
        .nav-section { font-family: 'Space Mono', monospace; font-size: 0.6rem; letter-spacing: 2px; text-transform: uppercase; color: rgba(255,255,255,0.45); padding: 16px 20px 6px; }
        .sidebar a { display: flex; align-items: center; gap: 10px; padding: 10px 20px; color: rgba(255,255,255,0.8); text-decoration: none; font-weight: 600; font-size: 0.9rem; transition: all 0.15s; border-left: 3px solid transparent; }
        .sidebar a:hover, .sidebar a.active { background: rgba(255,255,255,0.1); color: #fff; border-left-color: #f0b429; }
        .sidebar a .icon { font-size: 1rem; width: 20px; text-align: center; }
        .sidebar-footer { padding: 16px 20px; border-top: 1px solid rgba(255,255,255,0.15); font-family: 'Space Mono', monospace; font-size: 0.65rem; color: rgba(255,255,255,0.4); }
        .main { margin-left: 240px; flex: 1; min-height: 100vh; }
        .topbar { background: var(--white); border-bottom: 1px solid var(--border); padding: 16px 32px; display: flex; align-items: center; justify-content: space-between; }
        .topbar h1 { font-size: 1.3rem; font-weight: 800; color: var(--green); }
        .topbar .timestamp { font-family: 'Space Mono', monospace; font-size: 0.72rem; color: var(--muted); }
        .content { padding: 28px 32px; }
        .alert { padding: 12px 16px; border-radius: 6px; margin-bottom: 20px; font-weight: 600; font-size: 0.9rem; }
        .alert-success { background: var(--green-pale); color: var(--green); border: 1px solid #b2dfb2; }
        .alert-error { background: #fdecea; color: var(--red); border: 1px solid #f5c6cb; }
        .stat-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 16px; margin-bottom: 28px; }
        .stat-card { background: var(--white); border: 1px solid var(--border); border-radius: 10px; padding: 20px 22px; box-shadow: var(--shadow); }
        .stat-card .stat-label { font-family: 'Space Mono', monospace; font-size: 0.65rem; letter-spacing: 1.5px; text-transform: uppercase; color: var(--muted); }
        .stat-card .stat-value { font-size: 2.2rem; font-weight: 800; color: var(--green); line-height: 1.1; margin-top: 4px; }
        .stat-card .stat-sub { font-size: 0.78rem; color: var(--muted); margin-top: 4px; }
        .stat-card.gold .stat-value { color: var(--gold); }
        .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
        .card { background: var(--white); border: 1px solid var(--border); border-radius: 10px; padding: 24px; box-shadow: var(--shadow); }
        .card-title { font-size: 0.75rem; font-family: 'Space Mono', monospace; letter-spacing: 1.5px; text-transform: uppercase; color: var(--muted); margin-bottom: 16px; }
        table { width: 100%; border-collapse: collapse; font-size: 0.88rem; }
        th { font-family: 'Space Mono', monospace; font-size: 0.65rem; letter-spacing: 1.5px; text-transform: uppercase; color: var(--muted); padding: 8px 12px; text-align: left; border-bottom: 2px solid var(--border); }
        td { padding: 10px 12px; border-bottom: 1px solid #f0eadc; }
        tr:last-child td { border-bottom: none; }
        tr:hover td { background: var(--green-pale); }
        .badge { display: inline-block; padding: 2px 10px; border-radius: 20px; font-family: 'Space Mono', monospace; font-size: 0.65rem; font-weight: 700; }
        .badge-in { background: var(--green-pale); color: var(--green); }
        .badge-out { background: #fff3e0; color: var(--gold); }
        .empty { text-align: center; padding: 32px; color: var(--muted); font-size: 0.88rem; }
        @media (max-width: 900px) { .grid-2 { grid-template-columns: 1fr; } }
    </style>
</head>
<body>
<aside class="sidebar">
    <div class="sidebar-brand">
        <div class="logo-text">🌱 FarmAlert</div>
        <div class="logo-sub">Malawi · Admin</div>
    </div>
    <nav>
        <div class="nav-section">Overview</div>
        <a href="/dashboard" class="active"><span class="icon">📊</span> Dashboard</a>
        <div class="nav-section">Data</div>
        <a href="/farmers"><span class="icon">👨‍🌾</span> Farmers</a>
        <a href="/messages"><span class="icon">💬</span> Messages</a>
        <a href="/prices"><span class="icon">💰</span> Crop Prices</a>
        <div class="nav-section">Tools</div>
        <a href="/broadcast"><span class="icon">📡</span> Broadcast SMS</a>
    </nav>
    <div class="sidebar-footer">FarmAlert v1.0</div>
</aside>
<div class="main">
    <div class="topbar">
        <h1>📊 Dashboard</h1>
        <span class="timestamp" id="clock"></span>
    </div>
    <div class="content">
        <% if (typeof success !== 'undefined' && success) { %><div class="alert alert-success">✅ <%= success %></div><% } %>
        <% if (typeof error !== 'undefined' && error) { %><div class="alert alert-error">❌ <%= error %></div><% } %>

        <div class="stat-grid">
            <div class="stat-card">
                <div class="stat-label">Total Farmers</div>
                <div class="stat-value"><%= totalFarmers %></div>
                <div class="stat-sub">registered via SMS</div>
            </div>
            <div class="stat-card">
                <div class="stat-label">Total Messages</div>
                <div class="stat-value"><%= totalMessages %></div>
                <div class="stat-sub">all time</div>
            </div>
            <div class="stat-card">
                <div class="stat-label">Active Today</div>
                <div class="stat-value"><%= activeToday %></div>
                <div class="stat-sub">unique farmers</div>
            </div>
            <div class="stat-card gold">
                <div class="stat-label">Total Queries</div>
                <div class="stat-value"><%= totalQueries %></div>
                <div class="stat-sub">price lookups</div>
            </div>
            <div class="stat-card">
                <div class="stat-label">Last 24h Messages</div>
                <div class="stat-value"><%= recentMessages %></div>
                <div class="stat-sub">incoming + outgoing</div>
            </div>
            <% if (popularCrop) { %>
            <div class="stat-card gold">
                <div class="stat-label">Popular Crop</div>
                <div class="stat-value" style="font-size:1.5rem"><%= popularCrop %></div>
                <div class="stat-sub">most queried</div>
            </div>
            <% } %>
        </div>

        <div class="grid-2">
            <div class="card">
                <div class="card-title">Recent Farmers</div>
                <% if (recentFarmers.length === 0) { %>
                    <div class="empty">No farmers registered yet</div>
                <% } else { %>
                <table>
                    <thead><tr><th>Phone</th><th>Name</th><th>Queries</th></tr></thead>
                    <tbody>
                    <% recentFarmers.forEach(f => { %>
                        <tr>
                            <td><code style="font-size:0.8rem"><%= f.phone_number %></code></td>
                            <td><%= f.name || '—' %></td>
                            <td><%= f.total_queries %></td>
                        </tr>
                    <% }) %>
                    </tbody>
                </table>
                <% } %>
            </div>

            <div class="card">
                <div class="card-title">Recent Messages</div>
                <% if (!recentMsgs || recentMsgs.length === 0) { %>
                    <div class="empty">No messages yet</div>
                <% } else { %>
                <table>
                    <thead><tr><th>Phone</th><th>Dir</th><th>Message</th></tr></thead>
                    <tbody>
                    <% recentMsgs.slice(0,8).forEach(m => { %>
                        <tr>
                            <td style="font-size:0.78rem"><code><%= m.phone_number %></code></td>
                            <td><span class="badge badge-<%= m.direction === 'incoming' ? 'in' : 'out' %>"><%= m.direction %></span></td>
                            <td style="font-size:0.8rem;max-width:180px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap"><%= m.message %></td>
                        </tr>
                    <% }) %>
                    </tbody>
                </table>
                <% } %>
            </div>
        </div>
    </div>
</div>
<script>
    function updateClock() { const el = document.getElementById('clock'); if (el) el.textContent = new Date().toLocaleString('en-GB', {weekday:'short',day:'2-digit',month:'short',year:'numeric',hour:'2-digit',minute:'2-digit'}); }
    updateClock(); setInterval(updateClock, 60000);
</script>
</body>
</html>
